# Copy to .env and fill in. Everything is optional; the pipeline skips whatever is missing.

# Web search (website, company LinkedIn, founder LinkedIn). https://serper.dev ($50 ≈ 50k searches)
SERPER_API_KEY=

# Directors/founders by CIN from a licensed Indian company-data API (Probe42, Surepass, Signzy, Attestr, Tofler...).
# {cin} is replaced with the company's CIN. Map the response with the *_PATH / *_FIELD settings.
DIRECTORS_API_URL=
DIRECTORS_API_METHOD=GET
DIRECTORS_API_HEADERS={"x-api-key": "YOUR_KEY"}
# For POST APIs:  DIRECTORS_API_BODY={"cin": "{cin}"}
DIRECTORS_API_LIST_PATH=data.directors
DIRECTORS_API_NAME_FIELD=name
DIRECTORS_API_DIN_FIELD=din
DIRECTORS_API_ROLE_FIELD=designation

# Minimum startup score to shortlist (see README for how scoring works)
SCORE_THRESHOLD=4
